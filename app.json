{
  "expo": {
    "name": "Restaurant_App",
    "slug": "Restaurant_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "restaurantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siva.ggstinnovations.restaurantapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/android-apk-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FCF5E9",
        "foregroundImage": "./assets/images/android-apk-icon-foreground.png",
        "monochromeImage": "./assets/images/android-apk-icon-monochrome-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.siva.ggstinnovations.restaurantapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Restaurant_App to access photos.",
          "savePhotosPermission": "Allow Restaurant_App to save table QR codes.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Restaurant_App to attach restaurant images.",
          "cameraPermission": "Allow Restaurant_App to take restaurant photos.",
          "microphonePermission": "Allow Restaurant_App to use the microphone for voice search."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize speech for menu search.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f12cbdd-0efe-43b3-add9-7dcccf40dabf"
      }
    }
  }
}
